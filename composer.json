{
    "name": "vm-engine/synmod-fm",
    "description": "File Manager module for Laravel Synapse — browse, upload, manage files with per-folder ACL and TinyMCE integration",
    "keywords": [
        "laravel",
        "synapse",
        "module",
        "file-manager",
        "livewire"
    ],
    "type": "synapse-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Achmad Ardiansyah",
            "email": "theadods@gmail.com"
        }
    ],
    "require": {
        "livewire/livewire": "^4.0",
        "vm-engine/synapse": "^3.0",
        "vm-engine/synapps-auth": "^2.0|^3.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "VmEngine\\Fm\\": "src/",
            "VmEngine\\Fm\\Seeders\\": "database/seeders/",
            "VmEngine\\Fm\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VmEngine\\Fm\\FmServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../synapse"
        },
        {
            "type": "path",
            "url": "../synapps-auth"
        }
    ]
}
